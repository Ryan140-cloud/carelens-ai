# CareLens AI Environment Configuration Example

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./carelens.db
# DATABASE_URL=postgresql://carelens_user:carelens_password@localhost:5432/carelens_db

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
SECRET_KEY=carelens-secret-key-production-change-me-in-prod
MAX_UPLOAD_SIZE_MB=10

# ML Model Configuration
MODEL_TYPE=efficientnet_b0
MODEL_WEIGHTS_PATH=ml/checkpoints/carelens_efficientnet.pt
CONFIDENCE_THRESHOLD=0.45
ENABLE_GRADCAM=True

# Accessibility & i18n
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=["en","hi","pa"]
